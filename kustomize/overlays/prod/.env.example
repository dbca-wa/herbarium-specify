# ===== PRODUCTION ENVIRONMENT CONFIGURATION =====
# This is a template for production .env file
# Copy this to .env and fill in actual values
# NEVER commit the actual .env file to version control

# ===== DATABASE CONFIGURATION =====
# Using Azure MySQL (hosted database - not deployed in cluster)
# Production database server and credentials
DATABASE_HOST=prod-mysql-server.mysql.database.azure.com
DATABASE_PORT=3306
DATABASE_NAME=specify_prod
MASTER_NAME=specify_admin
MASTER_PASSWORD=<see creds/prod/master_user.txt>

# Note: Use specify_admin user for migrations (has CREATE, ALTER, DROP permissions)
# Note: MYSQL_ROOT_PASSWORD not needed for Azure MySQL

# ===== SECURITY =====
# Generate a NEW secure key for production (different from UAT/dev)
# Use: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=<generate-unique-secure-key-for-production>

# ===== ASSET SERVER =====
# Using in-cluster asset-server service
ASSET_SERVER_URL=http://asset-server:8080/web_asset_store.xml
# Generate a NEW secure key for production (different from UAT/dev)
ASSET_SERVER_KEY=<generate-unique-secure-key-for-production>

# ===== WEB CONFIGURATION =====
# Production domain
CSRF_TRUSTED_ORIGINS=https://specify.dbca.wa.gov.au

# ===== DEBUG AND LOGGING =====
# CRITICAL: Debug mode MUST be disabled in production
SP7_DEBUG=false
LOG_LEVEL=WARNING

# ===== IMPORTANT NOTES =====
# 1. Generate NEW keys for production - never reuse UAT/dev keys
# 2. Use specify_admin user for database (has migration permissions)
# 3. Verify CSRF_TRUSTED_ORIGINS matches production domain exactly
# 4. Keep .env file secure - it contains sensitive credentials
# 5. Backup .env file securely before making changes
# 6. Test configuration in UAT before applying to production

