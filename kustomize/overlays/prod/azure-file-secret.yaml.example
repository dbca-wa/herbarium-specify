# Azure File Share credentials secret template for PRODUCTION
#
# Copy to azure-file-secret.yaml, fill in the key, and apply:
#   kubectl apply -f azure-file-secret.yaml
#
# The actual secret file is gitignored.

apiVersion: v1
kind: Secret
metadata:
  name: azure-file-secret
  namespace: herbarium-specify
type: Opaque
stringData:
  azurestorageaccountname: dbcaherbariumspecify
  azurestorageaccountkey: <STORAGE_ACCOUNT_KEY>
