# Azure File Share credentials secret template
# 
# This file is a TEMPLATE for creating the azure-file-secret in Kubernetes.
# DO NOT commit the actual secret file with real credentials to git.
#
# To use this template:
# 1. Copy this file to azure-file-secret.yaml (which is gitignored)
# 2. Replace <STORAGE_ACCOUNT_KEY> with the actual key from OIM
# 3. Apply with: kubectl apply -f azure-file-secret.yaml
#
# OR create directly via Rancher UI:
# 1. Navigate to: Cluster > Storage > Secrets
# 2. Create Secret: azure-file-secret
# 3. Namespace: herbarium-specify
# 4. Type: Opaque
# 5. Add keys:
#    - azurestorageaccountname: dbcaherbariumspecify
#    - azurestorageaccountkey: <STORAGE_ACCOUNT_KEY>

apiVersion: v1
kind: Secret
metadata:
  name: azure-file-secret
  namespace: herbarium-specify
type: Opaque
stringData:
  azurestorageaccountname: dbcaherbariumspecify
  azurestorageaccountkey: <STORAGE_ACCOUNT_KEY>
